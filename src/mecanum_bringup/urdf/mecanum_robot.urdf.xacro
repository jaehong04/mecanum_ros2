<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="mecanum_robot">

  <!-- 실제 측정값 -->
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="half_wheelbase" value="0.095"/>
  <xacro:property name="half_track" value="0.11"/>

  <!-- 시각화용 값 -->
  <xacro:property name="wheel_width" value="0.04"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.20 0.08"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.20 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.03"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2"/>
        <inertia
          ixx="0.0002" ixy="0.0" ixz="0.0"
          iyy="0.0002" iyz="0.0"
          izz="0.0002"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel
    prefix="front_left"
    x="${half_wheelbase}"
    y="${half_track}"/>

  <xacro:wheel
    prefix="front_right"
    x="${half_wheelbase}"
    y="${-half_track}"/>

  <xacro:wheel
    prefix="rear_left"
    x="${-half_wheelbase}"
    y="${half_track}"/>

  <xacro:wheel
    prefix="rear_right"
    x="${-half_wheelbase}"
    y="${-half_track}"/>

  <ros2_control name="MecanumSerialSystem" type="system">
    <hardware>
      <plugin>mecanum_serial_hardware/MecanumSerialHardware</plugin>

      <param name="port">/dev/ttyUSB0</param>
      <param name="baud_rate">115200</param>
    </hardware>

    <!-- 순서 중요: FL, FR, RL, RR -->

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
