#!/usr/bin/env python3
"""Keyboard teleoperation for the mecanum drive controller."""

import select
import signal
import sys
import termios
import time
import tty

import rclpy
from geometry_msgs.msg import Twist


HELP = """
Mecanum keyboard (body frame)
 q  w  e     forward-left / forward / forward-right
 a  s  d     left         / STOP    / right
 z  x  c     back-left    / back    / back-right
 r / f       rotate counter-clockwise / clockwise in place
 t / y       forward curve left / right
 g / h       left/right strafe while turning
 v / b       reverse curve left / right
 + / -       increase / decrease speed (space also stops)
 Ctrl-C      stop and exit
"""

MOTION = {
    "q": (1.0, 1.0, 0.0),
    "w": (1.0, 0.0, 0.0),
    "e": (1.0, -1.0, 0.0),

    "a": (0.0, 1.0, 0.0),
    "s": (0.0, 0.0, 0.0),
    "d": (0.0, -1.0, 0.0),

    "z": (-1.0, 1.0, 0.0),
    "x": (-1.0, 0.0, 0.0),
    "c": (-1.0, -1.0, 0.0),

    "r": (0.0, 0.0, 1.0),
    "f": (0.0, 0.0, -1.0),

    "t": (1.0, 0.0, 0.55),
    "y": (1.0, 0.0, -0.55),

    "g": (0.0, 1.0, -0.55),
    "h": (0.0, -1.0, 0.55),

    "v": (-1.0, 0.0, -0.55),
    "b": (-1.0, 0.0, 0.55),

    " ": (0.0, 0.0, 0.0),
}


def make_twist(command, linear_speed, angular_speed):
    msg = Twist()

    msg.linear.x = command[0] * linear_speed
    msg.linear.y = command[1] * linear_speed
    msg.angular.z = command[2] * angular_speed

    return msg


def main():
    if not sys.stdin.isatty():
        print("ERROR: keyboard input needs an interactive terminal")
        return

    rclpy.init()

    node = rclpy.create_node("mecanum_keyboard")

    publisher = node.create_publisher(
        Twist,
        "/mecanum_drive_controller/reference_unstamped",
        10
    )

    linear_speed = 0.12
    angular_speed = 0.70

    command = (0.0, 0.0, 0.0)

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)

    stop_requested = False

    def handle_sigint(_signum, _frame):
        nonlocal stop_requested
        stop_requested = True

    # rclpy 기본 SIGINT 동작 대신 직접 종료 순서를 제어
    signal.signal(signal.SIGINT, handle_sigint)

    print(HELP, flush=True)
    print(
        f"speed: {linear_speed:.2f} m/s, "
        f"{angular_speed:.2f} rad/s",
        flush=True
    )

    try:
        tty.setcbreak(fd)

        while rclpy.ok() and not stop_requested:

            readable, _, _ = select.select(
                [sys.stdin],
                [],
                [],
                0.05
            )

            if readable:
                key = sys.stdin.read(1)

                if key in MOTION:
                    command = MOTION[key]

                elif key in ("+", "="):
                    linear_speed = min(
                        0.50,
                        linear_speed * 1.10
                    )

                    angular_speed = min(
                        2.50,
                        angular_speed * 1.10
                    )

                    print(
                        f"\nspeed: {linear_speed:.2f} m/s, "
                        f"{angular_speed:.2f} rad/s",
                        flush=True
                    )

                elif key in ("-", "_"):
                    linear_speed = max(
                        0.03,
                        linear_speed * 0.90
                    )

                    angular_speed = max(
                        0.15,
                        angular_speed * 0.90
                    )

                    print(
                        f"\nspeed: {linear_speed:.2f} m/s, "
                        f"{angular_speed:.2f} rad/s",
                        flush=True
                    )

            publisher.publish(
                make_twist(
                    command,
                    linear_speed,
                    angular_speed
                )
            )

            rclpy.spin_once(
                node,
                timeout_sec=0.0
            )

    except KeyboardInterrupt:
        pass

    finally:
        # 가장 먼저 터미널을 정상 상태로 복구
        try:
            termios.tcsetattr(
                fd,
                termios.TCSANOW,
                old_settings
            )
        except Exception:
            pass

        # ROS context가 살아 있을 때만 정지 명령 전송
        if rclpy.ok():
            try:
                stop = Twist()

                for _ in range(5):
                    publisher.publish(stop)
                    rclpy.spin_once(node, timeout_sec=0.02)

            except Exception as e:
                print(f"Stop publish warning: {e}")

        try:
            node.destroy_node()
        except Exception:
            pass

        if rclpy.ok():
            rclpy.shutdown()

        print("\nTeleop stopped - terminal restored.")



if __name__ == "__main__":
    main()
