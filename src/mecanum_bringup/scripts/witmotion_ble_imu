#!/usr/bin/env python3

import math
import struct
import serial

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Imu


G = 9.80665

ACC_SCALE = 16.0 / 32768.0
GYRO_SCALE = 2000.0 / 32768.0
ANGLE_SCALE = 180.0 / 32768.0


class WitmotionImu(Node):

    def __init__(self):
        super().__init__("witmotion_imu")

        self.declare_parameter("port", "/dev/ttyUSB0")
        self.declare_parameter("baud", 115200)
        self.declare_parameter("frame_id", "imu_link")

        self.port = self.get_parameter("port").value
        self.baud = self.get_parameter("baud").value
        self.frame_id = self.get_parameter("frame_id").value

        self.publisher = self.create_publisher(
            Imu,
            "/imu/data",
            20
        )

        self.ser = serial.Serial(
            self.port,
            self.baud,
            timeout=0
        )

        self.ser.reset_input_buffer()

        self.buffer = bytearray()

        self.timer = self.create_timer(
            0.01,
            self.read_serial
        )

        self.get_logger().info(
            f"IMU Run! ({self.port}, {self.baud}bps)"
        )

    def read_serial(self):

        waiting = self.ser.in_waiting

        if waiting > 0:
            self.buffer.extend(
                self.ser.read(waiting)
            )

        while len(self.buffer) >= 20:

            start = self.buffer.find(b"\x55\x61")

            if start < 0:
                self.buffer.clear()
                return

            if start > 0:
                del self.buffer[:start]

            if len(self.buffer) < 20:
                return

            frame = bytes(self.buffer[:20])
            del self.buffer[:20]

            self.publish_frame(frame)

    def publish_frame(self, frame):

        values = struct.unpack_from(
            "<9h",
            frame,
            2
        )

        ax, ay, az = [
            value * ACC_SCALE * G
            for value in values[0:3]
        ]

        gx, gy, gz = [
            math.radians(value * GYRO_SCALE)
            for value in values[3:6]
        ]

        roll, pitch, yaw = [
            math.radians(value * ANGLE_SCALE)
            for value in values[6:9]
        ]

        cr = math.cos(roll / 2.0)
        sr = math.sin(roll / 2.0)

        cp = math.cos(pitch / 2.0)
        sp = math.sin(pitch / 2.0)

        cy = math.cos(yaw / 2.0)
        sy = math.sin(yaw / 2.0)

        msg = Imu()

        msg.header.stamp = (
            self.get_clock().now().to_msg()
        )

        msg.header.frame_id = self.frame_id

        msg.orientation.w = cr * cp * cy + sr * sp * sy
        msg.orientation.x = sr * cp * cy - cr * sp * sy
        msg.orientation.y = cr * sp * cy + sr * cp * sy
        msg.orientation.z = cr * cp * sy - sr * sp * cy

        msg.angular_velocity.x = gx
        msg.angular_velocity.y = gy
        msg.angular_velocity.z = gz

        msg.linear_acceleration.x = ax
        msg.linear_acceleration.y = ay
        msg.linear_acceleration.z = az

        msg.orientation_covariance = [
            0.01, 0.0, 0.0,
            0.0, 0.01, 0.0,
            0.0, 0.0, 0.03
        ]

        msg.angular_velocity_covariance = [
            0.0025, 0.0, 0.0,
            0.0, 0.0025, 0.0,
            0.0, 0.0, 0.0025
        ]

        msg.linear_acceleration_covariance = [
            0.04, 0.0, 0.0,
            0.0, 0.04, 0.0,
            0.0, 0.0, 0.04
        ]

        self.publisher.publish(msg)

    def close(self):

        if self.ser.is_open:
            self.ser.close()


def main(args=None):

    rclpy.init(args=args)

    node = None

    try:
        node = WitmotionImu()
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    except serial.SerialException as error:
        print(f"IMU Serial Error: {error}")

    finally:

        if node is not None:
            node.close()
            node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
